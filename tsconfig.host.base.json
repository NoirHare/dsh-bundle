{
    "compilerOptions": {
        "composite": true,

        "target": "es2024",

        "lib": ["ES2024"],
        "types": ["node"],

        "rootDir": "${configDir}/src/host",

        "skipLibCheck": true,
        "declaration": true,
        "declarationDir": "${configDir}/lib/host",
        "emitDeclarationOnly": true,

        "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.host.tsbuildinfo"
    },
    "include": ["${configDir}/src/host"]
}
