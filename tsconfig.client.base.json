{
    "compilerOptions": {
        "composite": true,

        "target": "es2024",

        "lib": ["ES2024", "DOM"],
        "jsx": "react",

        "rootDir": "${configDir}/src/client",

        "skipLibCheck": true,
        "declaration": true,
        "declarationDir": "${configDir}/lib/client",
        "emitDeclarationOnly": true,

        "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.client.tsbuildinfo"
    },
    "include": ["${configDir}/src/client"]
}
