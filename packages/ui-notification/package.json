{
    "name": "@noirhare/dsh-ui-notification",
    "version": "0.0.8",
    "license": "MIT",
    "author": {
        "name": "NoirHare",
        "url": "https://github.com/NoirHare"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NoirHare/dsh-bundle.git",
        "directory": "packages/ui-notification"
    },
    "files": [
        "lib",
        "cordis.patch.yml"
    ],
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "exports": {
        ".": "./lib/host/index.js",
        "./client": "./lib/client/index.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec tsc -b && node build.ts",
        "prepublish": "pnpm build"
    },
    "dependencies": {
        "itiriri": "^2.0.1"
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "catalog:",
        "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
        "@deepseek-ai/dsh-api-session-controller": "catalog:",
        "@deepseek-ai/dsh-client-ui-session": "catalog:",
        "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
        "@deepseek-ai/dsh-client-ui-slots": "catalog:",
        "@deepseek-ai/dsh-client-ui-sidebar": "catalog:"
    },
    "dsh": {
        "client": {
            "inject": [],
            "platform": "web"
        },
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    }
}
